<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:com.mahonkin.tim.LoggingTest.TestMaui"
             x:Class="com.mahonkin.tim.LoggingTest.TestMaui.MainPage"
             BackgroundColor="{StaticResource Gray200}">
    <ScrollView>
        <VerticalStackLayout
            x:DataType="local:MainPage"
            Padding="0,0"
            Spacing="25">
            <Image
                Source="logo.png"
                HeightRequest="128"
                Aspect="AspectFit"/>
            <Label
                Text="Welcome to Maui Logging Test"
                Style="{StaticResource Headline}"/>
            <Grid
                Margin="20"
                RowSpacing="20"
                ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Button x:Name="CounterBtn"
                        Grid.Column="1"
                        Grid.Row="0"
                        Text="Click me!"
                        Clicked="OnCounterClicked"
                        HorizontalOptions="Fill"
                        CornerRadius="20"
                        TextColor="{StaticResource Black}"
                        BackgroundColor="{StaticResource Gray500}"/>
                <Picker x:Name="LevelPicker"
                        Grid.Column="0"
                        Grid.Row="1"
                        Title="Select A Log Level"
                        TextColor="{StaticResource Black}"/>
                <Entry x:Name="MessageText"
                       Grid.Column="1"
                       Grid.ColumnSpan="2"
                       Grid.Row="1"
                       Text="Type your message"
                       TextColor="{StaticResource Black}"/>
                <Button x:Name="MessageBtn"
                        Grid.Column="1"
                        Grid.Row="2"
                        Text="Click me to write a messge to the console log"
                        Clicked="OnMessageClicked"
                        HorizontalOptions="Fill"
                        CornerRadius="20"
                        TextColor="{StaticResource Black}"
                        BackgroundColor="{StaticResource Gray500}"/>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
